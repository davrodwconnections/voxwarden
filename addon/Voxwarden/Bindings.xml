<Bindings>
	<!-- The keys' own section in Options > Keybindings (C-127): the game names a
	     section after the global a binding's category names (_G[category],
	     Keybindings.lua:220-226), so category="BINDING_HEADER_NQA" is a
	     section called Voxwarden (Store.lua), as Blizzard_PingUI's keys get
	     theirs, and Bind Keys opens the page at it. No header: the page draws one
	     as a blank row. The binding names stay, so keys bound before still work.
	     Key names: BINDING_NAME_NQA_* (Store.lua). -->
	<!-- Replaces upstream's /r capture, which tainted /cast: this key opens the
	     Voxwarden window with the cursor in its input box, or closes it when it's
	     open (bound to a chord like Ctrl-B or an F key, it closes even while you
	     type). -->
	<Binding name="NQA_OPEN_AND_TYPE" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.OpenAndType then Voxwarden.OpenAndType() end
	</Binding>
	<!-- One key, one question, no typing (Commands.lua, ns.QuickAsk): what next,
	     your target, or the hovered item. The answer lands in the HUD and
	     in the "Quick questions" chat. -->
	<Binding name="NQA_ASK_NEXT" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.QuickAsk then Voxwarden.QuickAsk("next") end
	</Binding>
	<Binding name="NQA_ASK_TARGET" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.QuickAsk then Voxwarden.QuickAsk("target") end
	</Binding>
	<Binding name="NQA_ASK_ITEM" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.QuickAsk then Voxwarden.QuickAsk("item") end
	</Binding>
	<!-- The voice companion (odd/tasks/nqa-voice-controls.md): Talk opens its microphone for one
	     question; the others turn the microphone on or off and pause or resume the conversation. They
	     tell the Voxwarden app (a strip record), never the game. -->
	<Binding name="NQA_VOICE_TALK" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.Voice then Voxwarden.Voice("talk") end
	</Binding>
	<Binding name="NQA_VOICE_TIP" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.Voice then Voxwarden.Voice("tip") end
	</Binding>
	<Binding name="NQA_VOICE_MUTE" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.Voice then Voxwarden.Voice("toggle_mute") end
	</Binding>
	<Binding name="NQA_VOICE_PAUSE" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.Voice then Voxwarden.Voice("toggle_pause") end
	</Binding>
	<!-- The HUD's Okay: the newest reply is read and put away; nothing is sent. -->
	<Binding name="NQA_OKAY" category="BINDING_HEADER_NQA">
		if Voxwarden and Voxwarden.Okay then Voxwarden.Okay() end
	</Binding>
</Bindings>
